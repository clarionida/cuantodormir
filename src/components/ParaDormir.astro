---
// "Para dormir": meditaciones, escaneos corporales y sonidos de ambiente
// elegidos en src/data/audios.json, agrupados por tipo.
import Base from '../layouts/Base.astro';
import Video from './Video.astro';
import { alternativasDe, t } from '../i18n/rutas';
import type { Idioma } from '../lib/hora';
import { porTipo } from '../lib/audios';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = t(idioma);
const p = tx.paraDormir;
const grupos = porTipo(idioma);
const vacio = grupos.length === 0;
---

<Base
  idioma={idioma}
  titulo={p.metaTitulo}
  descripcion={p.metaDescripcion}
  alternativas={alternativasDe('paraDormir')}
  noindex={vacio}
  conLema={false}
>
  <div class="contenedor-texto">
    <header class="pagina-cabecera">
      <h1>{p.titulo}</h1>
      <p>{p.intro}</p>
    </header>
    {vacio && <p class="suave">{p.vacio}</p>}
    {
      grupos.map((g) => (
        <section>
          <h2>{tx.tipos[g.tipo]}</h2>
          <ul class="videos">
            {g.elementos.map((a) => (
              <li>
                <Video audio={a} idioma={idioma} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
