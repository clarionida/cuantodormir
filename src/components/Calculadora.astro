---
// Página completa de una calculadora (las 4 pestañas × 3 idiomas usan este
// mismo componente, con los mismos textos y el mismo selector de latencia).
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pestanas from './Pestanas.astro';
import Rueda, { type ColumnaRueda } from './Rueda.astro';
import TablaEjemplo from './TablaEjemplo.astro';
import Donacion from './Donacion.astro';
import Video from './Video.astro';
import { sitio } from '../config/sitio';
import { alternativasDe, ruta, t, type Calculadora } from '../i18n/rutas';
import { leerHora } from '../lib/calculo';
import { formatearHora, periodo, rellenar, type Idioma } from '../lib/hora';
import { esquemaAplicacion } from '../lib/esquemas';
import { yogaNidraPara } from '../lib/audios';

interface Props {
  idioma: Idioma;
  pestana: Calculadora;
}
const { idioma, pestana } = Astro.props;
const tx = t(idioma);
const c = tx.calculadoras[pestana];
const cfg = sitio.calculadora;

const usaHora = pestana === 'despertar' || pestana === 'acostarse';
const horaPorDefecto = pestana === 'despertar' ? cfg.despertarPorDefecto : pestana === 'acostarse' ? cfg.acostarsePorDefecto : null;
const inicial = leerHora(horaPorDefecto) ?? { h: 8, m: 0 };
const dosDigitos = (n: number) => String(n).padStart(2, '0');

// Columnas de la rueda de hora: 12 horas + a. m./p. m. (es, en) o 24 horas (pt).
const columnasHora: ColumnaRueda[] =
  idioma === 'pt'
    ? [
        { clave: 'h', etiqueta: tx.rueda.hora, inicial: inicial.h, salto: 6, valores: Array.from({ length: 24 }, (_, h) => ({ valor: h, texto: dosDigitos(h) })) },
        { clave: 'm', etiqueta: tx.rueda.minutos, inicial: inicial.m, salto: 3, valores: Array.from({ length: 12 }, (_, i) => ({ valor: i * 5, texto: dosDigitos(i * 5) })) },
      ]
    : [
        { clave: 'h', etiqueta: tx.rueda.hora, inicial: inicial.h % 12 || 12, salto: 3, valores: Array.from({ length: 12 }, (_, i) => ({ valor: i + 1, texto: String(i + 1) })) },
        { clave: 'm', etiqueta: tx.rueda.minutos, inicial: inicial.m, salto: 3, valores: Array.from({ length: 12 }, (_, i) => ({ valor: i * 5, texto: dosDigitos(i * 5) })) },
        { clave: 'p', etiqueta: tx.rueda.periodo, inicial: inicial.h >= 12 ? 1 : 0, salto: 1, ancha: true, valores: [{ valor: 0, texto: periodo(0, idioma) }, { valor: 1, texto: periodo(12, idioma) }] },
      ];

const columnasLatencia: ColumnaRueda[] = [
  {
    clave: 'lat',
    etiqueta: tx.latencia.columna,
    inicial: cfg.latenciaPorDefecto,
    salto: 10,
    ancha: true,
    valores: Array.from({ length: cfg.latenciaMaxima - cfg.latenciaMinima + 1 }, (_, i) => ({
      valor: cfg.latenciaMinima + i,
      texto: String(cfg.latenciaMinima + i),
    })),
  },
];

// Texto completo inicial para lectores de pantalla.
const textoHoraInicial = formatearHora(inicial, idioma);
const textoLatenciaInicial = rellenar(tx.latencia.valorTexto, { x: cfg.latenciaPorDefecto });

// Bloque explicativo (Markdown) bajo la herramienta.
const bloque = await getEntry('paginas', `${idioma}/calc-${pestana}`);
const { Content } = bloque ? await render(bloque) : { Content: null };

// "Para acompañarte" (solo en Siesta y solo si hay yoga nidra con duración similar).
const acompanar =
  pestana === 'siesta'
    ? cfg.siestasMin
        .map((min) => ({ min, audios: yogaNidraPara(min, idioma).slice(0, 1) }))
        .filter((g) => g.audios.length > 0)
    : [];

const datos = {
  idioma,
  pestana,
  config: {
    ciclo: cfg.cicloMin,
    cicloMin: cfg.cicloMinimo,
    cicloMax: cfg.cicloMaximo,
    siestas: cfg.siestasMin,
    ciclosMaximos: cfg.ciclosMaximos,
    ciclosRecomendados: cfg.ciclosRecomendados,
    latencia: cfg.latenciaPorDefecto,
    latenciaMin: cfg.latenciaMinima,
    latenciaMax: cfg.latenciaMaxima,
    hora: horaPorDefecto,
    minutosRecalcular: cfg.minutosParaRecalcular,
  },
  t: {
    relojPlural: tx.relojPlural,
    relojSingular: tx.relojSingular,
    calculadoPlural: tx.calculadoPlural,
    calculadoSingular: tx.calculadoSingular,
    ciclos: tx.resultados.ciclos,
    ciclo: tx.resultados.ciclo,
    siesta: tx.resultados.siesta,
    recomendado: tx.resultados.recomendado,
    yaPaso: tx.resultados.yaPaso,
    notaLatencia: tx.resultados.notaLatencia,
    valorLatencia: tx.latencia.valorTexto,
    siestas: tx.resultados.siestas,
    despedidas: tx.resultados.despedidas,
    copiado: tx.resultados.copiado,
    compartirTitulo: tx.resultados.compartirTitulo,
    titulo: c.resultados,
    unidad: tx.latencia.unidad,
  },
};

const esquemas = [
  esquemaAplicacion({
    nombre: c.nombreApp,
    descripcion: c.metaDescripcion,
    url: ruta(pestana, idioma),
    idioma,
  }),
];
---

<Base
  idioma={idioma}
  titulo={c.metaTitulo}
  descripcion={c.metaDescripcion}
  alternativas={alternativasDe(pestana)}
  esquemas={esquemas}
>
  <Pestanas idioma={idioma} activa={pestana} />

  <div class="contenedor" data-calculadora>
    <div class="calc-cabecera">
      <h1>{c.titulo}</h1>
      {
        pestana === 'ahora' ? (
          <p>
            <span class="reloj" data-reloj hidden />
            {c.subtitulo}
          </p>
        ) : (
          <p>{c.subtitulo}</p>
        )
      }
      {pestana === 'siesta' && <p class="reloj" data-reloj hidden />}
    </div>

    <form data-formulario novalidate>
      {
        usaHora && (
          <div class="campo">
            <span class="campo-etiqueta" id={`etiqueta-hora-${pestana}`}>
              {'etiquetaHora' in c ? c.etiquetaHora : ''}
            </span>
            <Rueda
              id={`rueda-hora-${pestana}`}
              tipo="hora"
              etiquetadaPor={`etiqueta-hora-${pestana}`}
              columnas={columnasHora.map((col) => ({ ...col, textoInicial: textoHoraInicial }))}
              separadores={[':', null]}
            />
          </div>
        )
      }

      <div class="campo">
        <span class="campo-etiqueta" id={`etiqueta-latencia-${pestana}`}>{tx.latencia.etiqueta}</span>
        <Rueda
          id={`rueda-latencia-${pestana}`}
          tipo="latencia"
          etiquetadaPor={`etiqueta-latencia-${pestana}`}
          columnas={columnasLatencia.map((col) => ({ ...col, textoInicial: textoLatenciaInicial }))}
          unidad={tx.latencia.unidad}
        />
        <p class="nota-latencia">
          {tx.latencia.nota}
          <span class="burbuja-ancla" data-burbuja-ancla>
            <button
              type="button"
              class="boton-i"
              data-burbuja-boton
              aria-expanded="false"
              aria-controls={`burbuja-${pestana}`}
              aria-label={tx.latencia.infoBoton}
            >
              <span aria-hidden="true">i</span>
            </button>
            <span class="burbuja" id={`burbuja-${pestana}`} data-burbuja hidden>
              <span>{tx.latencia.info}</span>
              <button type="button" class="cerrar" data-burbuja-cerrar aria-label={tx.latencia.cerrar}>
                <span aria-hidden="true">×</span>
              </button>
            </span>
          </span>
        </p>
      </div>

      <details class="ajuste">
        <summary>{tx.ajuste.enlace}</summary>
        <div class="ajuste-cuerpo">
          <p>{tx.ajuste.explica}</p>
          <div class="ajuste-fila">
            <label class="sr-only" for={`ciclo-${pestana}`}>{tx.ajuste.etiqueta}</label>
            <input
              type="range"
              id={`ciclo-${pestana}`}
              min={cfg.cicloMinimo}
              max={cfg.cicloMaximo}
              step="1"
              value={cfg.cicloMin}
              data-ciclo
            />
            <output for={`ciclo-${pestana}`} data-ciclo-valor>{cfg.cicloMin} {tx.latencia.unidad}</output>
          </div>
          <button type="button" class="boton boton--sutil" data-ciclo-restablecer>{tx.ajuste.restablecer}</button>
        </div>
      </details>

      <button type="submit" class="boton boton--ancho">{tx.calcular}</button>
      <noscript><p class="suave" style="margin-top:1rem">{tx.sinJs}</p></noscript>
    </form>

    <section class="resultados" data-resultados hidden aria-labelledby={`titulo-resultados-${pestana}`}>
      <h2 id={`titulo-resultados-${pestana}`} tabindex="-1" data-titulo-resultados>{c.resultados}</h2>
      {!usaHora && <p class="calculado" data-calculado hidden />}
      <ol class="tarjetas" data-tarjetas></ol>
      <div class="resultados-notas">
        <p data-nota-latencia></p>
        {
          pestana !== 'siesta' && (
            <p>
              {tx.resultados.explicaRecomendado}{' '}
              <a href="https://pubmed.ncbi.nlm.nih.gov/25979105/" target="_blank" rel="noopener">
                {tx.resultados.fuenteRecomendado}
              </a>
            </p>
          )
        }
        <p class="despedida" data-despedida></p>
      </div>
      <div class="acciones">
        <button type="button" class="boton boton--sutil" data-accion="cambiar">{tx.resultados.cambiar}</button>
        <button type="button" class="boton boton--sutil" data-accion="nueva">{tx.resultados.nueva}</button>
        <button type="button" class="boton boton--sutil" data-accion="compartir">{tx.resultados.compartir}</button>
      </div>
      <p class="estado-compartir" role="status" data-estado-compartir></p>
      {
        !usaHora && (
          <button type="button" class="boton boton--ancho recalcular" data-accion="recalcular" hidden>
            {tx.resultados.recalcular}
          </button>
        )
      }

      {
        acompanar.length > 0 && (
          <section aria-labelledby={`acompanarte-${pestana}`}>
            <h2 id={`acompanarte-${pestana}`}>{tx.resultados.acompanarte}</h2>
            <p class="suave">{tx.resultados.acompanarteIntro}</p>
            <ul class="videos">
              {acompanar.map((g) => (
                <li>
                  <h3>{rellenar(tx.resultados.paraSiesta, { x: g.min })}</h3>
                  {g.audios.map((a) => (
                    <Video audio={a} idioma={idioma} />
                  ))}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="donacion-linea">
        <Donacion idioma={idioma} />
      </div>
    </section>

    <div class="sr-only" aria-live="polite" data-anuncio></div>
  </div>

  <section class="contenedor texto-largo">
    {Content && <Content />}
    <TablaEjemplo idioma={idioma} pestana={pestana} />
  </section>

  <script type="application/json" id="cd-datos" set:html={JSON.stringify(datos)} />
  <script>
    import '../scripts/calculadora';
  </script>
</Base>
