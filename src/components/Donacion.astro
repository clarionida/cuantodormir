---
// Invitación a donar ("Invitar un té"). Solo se usa en el pie de página y al
// final de los resultados. Nunca en ventanas emergentes ni antes de los
// resultados.
import { sitio } from '../config/sitio';
import { t } from '../i18n/rutas';
import type { Idioma } from '../lib/hora';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = t(idioma);
---

<p>
  {tx.donacion.texto}
  <a class="boton-te" href={sitio.enlaces.donacion} target="_blank" rel="noopener">
    <svg class="icono-taza" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"></path>
      <path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16"></path>
      <path d="M8 3.5c0 1 1 1.2 1 2.2M11.5 3.5c0 1 1 1.2 1 2.2"></path>
    </svg>
    {tx.donacion.boton}<span class="sr-only"> {tx.pie.nuevaPestana}</span>
  </a>
</p>
