---
// Índice de la guía. En español muestra todos los artículos (los borradores
// con su aviso). En inglés y portugués, las traducciones revisadas y, mientras
// tanto, los artículos revisados en español.
import Base from '../layouts/Base.astro';
import { alternativasDe, ruta, t } from '../i18n/rutas';
import type { Idioma } from '../lib/hora';
import { articulosPublicados, articulosRevisadosEnEspanol, urlDe } from '../lib/guia';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = t(idioma);
const g = tx.guia;
const propios = await articulosPublicados(idioma);
const enEspanol = idioma === 'es' ? [] : await articulosRevisadosEnEspanol();
const vacio = propios.length === 0 && enEspanol.length === 0;
// Un índice vacío en/pt no se indexa (sería una página sin contenido).
const noindex = idioma !== 'es' && vacio;
// Solo se anuncian (hreflang) las versiones que tienen artículos.
const revisadosEs = await articulosRevisadosEnEspanol();
const tieneContenido = async (i: Idioma) =>
  i === 'es' || revisadosEs.length > 0 || (await articulosPublicados(i)).length > 0;
const todas = alternativasDe('guia');
const alternativas = {
  es: todas.es,
  ...((await tieneContenido('en')) ? { en: todas.en } : {}),
  ...((await tieneContenido('pt')) ? { pt: todas.pt } : {}),
};
---

<Base
  idioma={idioma}
  titulo={g.metaTitulo}
  descripcion={g.metaDescripcion}
  alternativas={alternativas}
  noindex={noindex}
  conLema={false}
>
  <div class="contenedor-texto">
    <header class="pagina-cabecera">
      <h1>{g.titulo}</h1>
      <p>{g.intro}</p>
      {idioma !== 'es' && <p>{g.soloEspanol}</p>}
    </header>

    {
      propios.length > 0 && (
        <ul class="lista-articulos">
          {propios.map((a) => (
            <li>
              <a href={urlDe(a)}>
                <span class="titulo-articulo">{a.data.titulo}</span>
                <span class="resumen">{a.data.descripcion}</span>
                {!a.data.revisado && <span class="versalitas">{g.borrador.split(':')[0]}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      enEspanol.length > 0 && (
        <ul class="lista-articulos" lang="es">
          {enEspanol.map((a) => (
            <li>
              <a href={urlDe(a)} hreflang="es">
                <span class="titulo-articulo">{a.data.titulo}</span>
                <span class="resumen">{a.data.descripcion}</span>
                <span class="versalitas" lang={tx.htmlLang}>{g.enEspanol}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {vacio && <p class="suave">{g.pronto}</p>}

    <p class="enlaces-finales">
      <a href={ruta('preguntas', idioma)}>{tx.menu.preguntas}</a> · <a href={ruta('metodo', idioma)}>{tx.menu.metodo}</a>
    </p>
  </div>
</Base>
